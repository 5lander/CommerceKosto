// Esquema de datos de costeo-saas.
//
// LO QUE NO ESTA AQUI, Y ES DELIBERADO: las politicas RLS.
//
// Prisma 7 no sabe declararlas (el RLS nativo existe solo en Prisma 8, que es
// Release Candidate — ver ADR-001 y ADR-002). Van como SQL manual dentro del
// bloque `-- MANUAL:` de cada migracion, donde ademas tienen expresividad
// COMPLETA: `FORCE ROW LEVEL SECURITY`, politicas restrictivas y deny-by-default.
// Nada de eso esta documentado como expresable desde la PSL de Prisma 8.
//
// `audit:migrations` M6 hace imposible olvidarlas: una migracion que crea una
// tabla sin ENABLE + FORCE + al menos una POLICY rompe el build.

// GENERADOR `prisma-client-js` Y NO EL NUEVO `prisma-client`, con motivo.
//
// El generador nuevo emite TypeScript, y ese TypeScript entra en la compilacion
// del proyecto: `audit:types` pasa a type-checkear ~40 000 lineas de codigo
// generado en cada commit —agota el heap por defecto de `tsc` y obliga a
// subirlo a 4 GB— y `tsc --build` falla con TS6059 porque el codigo generado
// cae fuera del `rootDir`. Todo eso para verificar un artefacto de build que
// nadie escribe a mano y que ya viene con `@ts-nocheck` puesto.
//
// `prisma-client-js` emite JavaScript con sus `.d.ts`, que `skipLibCheck` omite:
// la compilacion vuelve a ser instantanea y el build emite lo que tiene que
// emitir. Esta deprecado en favor del nuevo, asi que el cambio entra en la
// evaluacion de Prisma 8 que ADR-001 ya deja pendiente — no antes, y no como
// efecto secundario de otra cosa.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Registro de auditoria — SEGURIDAD.md §10.
///
/// APPEND-ONLY EN TRES CAPAS:
///   1. Privilegio: REVOKE UPDATE, DELETE, TRUNCATE para costeo_app
///   2. Trigger BEFORE UPDATE OR DELETE OR TRUNCATE ... FOR EACH STATEMENT,
///      que alcanza tambien al dueno de la tabla
///   3. Regla `append-only-cliente-audit_log` de audit:forbidden
///
/// El trigger es de SENTENCIA y no de fila, y esa distincion no es cosmetica:
/// con FORCE ROW LEVEL SECURITY activo y sin politica de DELETE, un
/// `DELETE FROM audit_log` afecta a CERO filas, un trigger de fila nunca se
/// dispara, y el borrado "tiene exito" en silencio.
model AuditLog {
  id String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  at DateTime @default(now()) @db.Timestamptz(6)

  eventType String  @map("event_type")
  outcome   String
  actorType String  @map("actor_type")
  actorId   String? @map("actor_id") @db.Uuid

  /// Nullable A PROPOSITO, y lo seguira siendo. El catalogo de SEGURIDAD.md §10
  /// incluye eventos que por naturaleza no tienen tenant:
  /// `system.migration.applied`, `system.config.changed`,
  /// `system.ratelimit.exceeded`, `admin.login.*`.
  /// P1 anade la clave foranea con ON DELETE RESTRICT — jamas CASCADE: borrar
  /// una company no puede borrar su rastro de auditoria.
  companyId String? @map("company_id") @db.Uuid

  ip            String? @db.Inet
  geoCountry    String? @map("geo_country") @db.Char(2)
  geoCity       String? @map("geo_city")
  userAgent     String? @map("user_agent")
  deviceId      String? @map("device_id") @db.Uuid
  correlationId String  @map("correlation_id") @db.Uuid

  /// Solo IDs y escalares. Jamas datos personales en claro ni secretos.
  detail Json @default("{}")

  tipoDeEvento AuditEventType @relation(fields: [eventType], references: [code])
  resultado    AuditOutcome   @relation(fields: [outcome], references: [code])
  tipoDeActor  AuditActorType @relation(fields: [actorType], references: [code])

  @@index([at(sort: Desc)])
  @@index([correlationId])
  @@map("audit_log")
}

/// Catalogo de tipos de evento. CLAUDE.md §5: "enums en tabla de catalogo, no
/// en tipo nativo" — un enum nativo de PostgreSQL exige una migracion con
/// bloqueo para anadir un valor, y este catalogo crece en cada paquete.
model AuditEventType {
  code            String  @id
  domain          String
  requiresCompany Boolean @default(true) @map("requires_company")

  registros AuditLog[]

  @@map("audit_event_type")
}

/// success · failure · blocked
model AuditOutcome {
  code String @id

  registros AuditLog[]
  intentos  LoginAttempt[]

  @@map("audit_outcome")
}

/// USER · SYSTEM · BACKOFFICE · ANONYMOUS
model AuditActorType {
  code String @id

  registros AuditLog[]

  @@map("audit_actor_type")
}

// ===========================================================================
// P1 — IAM, multi-tenancy, ubicaciones y roles
// ===========================================================================
//
// TODA TABLA DE NEGOCIO LLEVA `company_id`, sin excepcion (CLAUDE.md §4.1), y
// su politica RLS se crea en la MISMA migracion que la tabla. `audit:migrations`
// M6 lo hace imposible de olvidar.
//
// `company` es el unico caso especial: su llave de aislamiento es su propio
// `id`, no una columna aparte.

/// Un tenant. Tenant = company: un comercio, un tenant, sin nivel intermedio
/// (SPEC §1).
model Company {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  status    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Limite de plan (D5). El plan como entidad llega en P11; hasta entonces el
  /// limite vive aqui con un valor generoso. Se verifica en el backend desde el
  /// primer paquete que lo toca, que es este.
  maxLocations Int @default(10) @map("max_locations")

  estado                CompanyStatus         @relation(fields: [status], references: [code])
  settings              CompanySettings?
  locations             Location[]
  usuarios              AppUser[]
  roles                 UserRole[]
  sesiones              Session[]
  grupos                ItemGroup[]
  items                 Item[]
  articulos             PurchaseArticle[]
  precios               ReferencePrice[]
  productos             Product[]
  productosPorUbicacion ProductLocation[]
  combos                ComboComponent[]
  recetas               Recipe[]
  lineasDeReceta        RecipeLine[]
  propagaciones         RecipePropagation[]
  movimientos           InventoryMovement[]
  transferencias        InventoryTransfer[]
  producciones          InventoryProduction[]
  periodos              Period[]
  conteos               PhysicalCount[]
  lineasDeConteo        PhysicalCountLine[]
  ventas                ProductSales[]
  costosFijos           FixedCost[]

  @@map("company")
}

/// ACTIVE - SUSPENDED - CLOSED
model CompanyStatus {
  code String @id

  companies Company[]

  @@map("company_status")
}

/// Los parametros de costeo de D3. NO son constantes del codigo: el motor los
/// recibe como parametro.
///
/// `numeric(24,12)` en todos los ratios: es el contrato de la escala
/// ALMACENAMIENTO de shared/domain/decimal/escalas.ts. Un flotante aqui
/// romperia R7 desde el origen de los datos.
model CompanySettings {
  companyId String @id @map("company_id") @db.Uuid

  ivaVenta             Decimal @map("iva_venta") @db.Decimal(24, 12)
  ivaCompraRecuperable Boolean @map("iva_compra_recuperable")
  /// Tasa de IVA de compra por DEFECTO, la que se propone al capturar un
  /// precio. La que manda es la de cada `reference_price`: la factura dice cual
  /// aplico, y en Ecuador el alimento sin procesar es 0 % y el detergente 15 %.
  ivaCompra            Decimal @map("iva_compra") @db.Decimal(24, 12)
  provisionMerma       Decimal @map("provision_merma") @db.Decimal(24, 12)
  foodCostObjetivo     Decimal @map("food_cost_objetivo") @db.Decimal(24, 12)
  foodCostMaximo       Decimal @map("food_cost_maximo") @db.Decimal(24, 12)
  foodCostUmbralVerde  Decimal @map("food_cost_umbral_verde") @db.Decimal(24, 12)
  primeCostMaximo      Decimal @map("prime_cost_maximo") @db.Decimal(24, 12)
  reglaPopularidad     Decimal @map("regla_popularidad") @db.Decimal(24, 12)
  diasOperativosMes    Int     @map("dias_operativos_mes")
  diasCobertura        Int     @map("dias_cobertura")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("company_settings")
}

/// No existe "sucursal" a secas (SPEC §2): existe ubicacion CON TIPO. Una
/// bodega modelada como local aparece con ventas en cero y contamina todo
/// reporte comparativo.
model Location {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  type      String
  status    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company    Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  tipo       LocationType              @relation(fields: [type], references: [code])
  estado     LocationStatus            @relation(fields: [status], references: [code])
  roles      UserRole[]
  productos  ProductLocation[]
  recetas    Recipe[]
  propagados RecipePropagationTarget[]

  movimientos           InventoryMovement[]
  transferenciasSalida  InventoryTransfer[]   @relation("origen")
  transferenciasEntrada InventoryTransfer[]   @relation("destino")
  producciones          InventoryProduction[]
  periodos              Period[]

  @@unique([companyId, name])
  /// Clave candidata para las FK COMPUESTAS del libro de inventario: atan cada
  /// movimiento a la misma company que su ubicacion. RLS filtra lo que se lee,
  /// no lo que se referencia.
  @@unique([id, companyId])
  @@index([companyId, status])
  @@map("location")
}

/// BODEGA - LOCAL - AMBOS
model LocationType {
  code     String  @id
  vende    Boolean
  almacena Boolean

  locations Location[]

  @@map("location_type")
}

/// ACTIVE - INACTIVE
model LocationStatus {
  code String @id

  locations Location[]

  @@map("location_status")
}

/// Se llama `app_user` y no `user` porque `user` es palabra reservada en
/// PostgreSQL: una consulta sobre `user` devuelve el nombre del rol de sesion,
/// no la tabla, y el error que produce no dice nada de eso.
model AppUser {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  /// Siempre en minusculas. La unicidad es GLOBAL, no por company: el login
  /// ocurre ANTES de saber a que tenant pertenece quien entra.
  email        String   @unique
  /// Argon2id. NULL mientras la invitacion este pendiente.
  passwordHash String?  @map("password_hash")
  status       String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Invitacion pendiente. El token vive HASHEADO, igual que el de sesion: un
  /// volcado de la base no permite activar la cuenta de nadie.
  ///
  /// Van en `app_user` y no en una tabla aparte porque el dominio es
  /// exactamente uno a uno: un usuario tiene como mucho UNA invitacion viva.
  /// Reinvitar sobrescribe el token, que ademas es el comportamiento correcto
  /// —el enlace anterior deja de servir— y sale gratis.
  invitationTokenHash String?   @unique @map("invitation_token_hash")
  invitationExpiresAt DateTime? @map("invitation_expires_at") @db.Timestamptz(6)

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  estado         UserStatus       @relation(fields: [status], references: [code])
  roles          UserRole[]
  sesiones       Session[]
  preciosCreados ReferencePrice[] @relation("precios_creados")

  movimientos    InventoryMovement[]
  transferencias InventoryTransfer[]
  producciones   InventoryProduction[]

  periodosCerrados   Period[]        @relation("cerro")
  periodosReabiertos Period[]        @relation("reabrio")
  conteosCreados     PhysicalCount[] @relation("conteos_creados")
  conteosConfirmados PhysicalCount[] @relation("conteos_confirmados")
  ventasCargadas     ProductSales[]
  costosCargados     FixedCost[]

  @@index([companyId, status])
  @@map("app_user")
}

/// INVITED - ACTIVE - SUSPENDED
model UserStatus {
  code String @id

  usuarios AppUser[]

  @@map("user_status")
}

/// Catalogo de roles (SPEC §4).
///
/// `requiresLocation` no es documentacion: participa en una clave foranea
/// compuesta desde `user_role`, de modo que asignar GERENTE_LOCAL sin ubicacion
/// —o ADMIN con una— es imposible en la base, no solo desaconsejado.
model Role {
  code             String  @id
  requiresLocation Boolean @map("requires_location")

  permisos     RolePermission[]
  asignaciones UserRole[]

  @@unique([code, requiresLocation])
  @@map("role")
}

/// Capacidades, no roles rigidos (SPEC §4). Cada paquete siembra las suyas.
model Permission {
  code   String @id
  domain String

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleCode       String @map("role_code")
  permissionCode String @map("permission_code")

  rol     Role       @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permiso Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleCode, permissionCode])
  @@map("role_permission")
}

/// Asignacion de un rol a un usuario, opcionalmente acotada a una ubicacion.
model UserRole {
  id         String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId  String  @map("company_id") @db.Uuid
  userId     String  @map("user_id") @db.Uuid
  roleCode   String  @map("role_code")
  locationId String? @map("location_id") @db.Uuid

  /// Existe para sostener la clave foranea COMPUESTA contra
  /// `role(code, requires_location)`. Un CHECK impide que mienta respecto de
  /// `location_id`, y la clave foranea impide asignar GERENTE_LOCAL sin
  /// ubicacion o ADMIN con una. Las dos cosas en la base, no en un `if`.
  hasLocation Boolean @default(false) @map("has_location")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  usuario  AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// La relacion es por PAR (rol, tiene ubicacion), no solo por rol.
  rol      Role      @relation(fields: [roleCode, hasLocation], references: [code, requiresLocation], onDelete: Restrict)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([userId, roleCode, locationId])
  @@index([companyId, userId])
  @@map("user_role")
}

/// Sesion con token OPACO. En la base vive solo el hash: un volcado de la base
/// no permite suplantar a nadie (SEGURIDAD.md §2.2).
model Session {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  ip        String? @db.Inet
  userAgent String? @map("user_agent")
  deviceId  String? @map("device_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  usuario AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, expiresAt])
  @@map("session")
}

/// Intentos de login — SEGURIDAD.md §2.1.
///
/// NO LLEVA `company_id`, Y ES DELIBERADO. El login ocurre antes de saber a que
/// tenant pertenece quien lo intenta; una tabla con tenant no se podria
/// consultar en ese momento. Se acota por otro lado: solo guarda correo e IP,
/// nunca sale por ninguna respuesta, y ningun endpoint la expone.
///
/// Vive en PostgreSQL y no en Redis (decision del usuario, ver ADR-006): el
/// bloqueo de una cuenta SOBREVIVE a un reinicio. Con un almacen volatil, un
/// flush levanta todos los bloqueos activos sin que nadie se entere.
model LoginAttempt {
  id      String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email   String
  ip      String?  @db.Inet
  at      DateTime @default(now()) @db.Timestamptz(6)
  outcome String

  resultado AuditOutcome @relation(fields: [outcome], references: [code])

  @@index([email, at(sort: Desc)])
  @@index([ip, at(sort: Desc)])
  @@map("login_attempt")
}

// ---------------------------------------------------------------------------
// P2 — Catalogo: la FUENTE UNICA DE VERDAD del proyecto (CLAUDE.md §2).
//
// Ningun otro modulo crea, edita ni borra items, articulos ni unidades. Los
// demas referencian por ID y leen a traves de los puertos de `catalog`. Lo hace
// cumplir una regla de `dependency-cruiser`, no la buena voluntad.
// ---------------------------------------------------------------------------

/// Catalogo GLOBAL de unidades, sin tenant.
///
/// POR QUE GLOBAL Y NO POR COMPANY. Un kilogramo pesa lo mismo en todas las
/// companies: `factor_a_base` es una constante fisica, no una preferencia. Un
/// catalogo por tenant significaria que cada company puede declarar que su
/// kilo tiene 900 gramos, y ese error saldria como un costo plausible y
/// equivocado. La aplicacion NO tiene INSERT sobre esta tabla.
///
/// La contrapartida, dicha en voz alta: no se pueden crear unidades propias
/// ("atado", "bandeja"). Se modelan como presentacion del articulo de compra
/// —"atado de 6 unid"—, que es donde de verdad viven. Si algun dia hiciera
/// falta de otra forma, seria una columna `company_id` nullable aqui, con
/// politica `company_id IS NULL OR company_id = current_company()`.
model Unit {
  code      String @id
  name      String
  dimension String

  /// Cuantas unidades BASE de su dimension hay en una de estas. La base es la
  /// que tiene factor 1: gramo, mililitro, unidad. `numeric(24,12)` como todo
  /// lo que participa en un calculo (ADR-003).
  factorToBase Decimal @map("factor_to_base") @db.Decimal(24, 12)

  magnitud           UnitDimension     @relation(fields: [dimension], references: [code])
  itemsQueLaUsan     Item[]
  articulosQueLaUsan PurchaseArticle[]

  @@index([dimension])
  @@map("unit")
}

/// MASA · VOLUMEN · CONTEO. Dos unidades solo se convierten entre si sin factor
/// explicito cuando comparten dimension.
model UnitDimension {
  code String @id

  unidades Unit[]

  @@map("unit_dimension")
}

/// COMPRADO · PRODUCIDO (SPEC §5).
model ItemType {
  code String @id

  items Item[]

  @@map("item_type")
}

/// ACTIVE · INACTIVE. Sin borrado fisico (CLAUDE.md §5).
model ItemStatus {
  code String @id

  items     Item[]
  articulos PurchaseArticle[]

  @@map("item_status")
}

/// FACTURA · ESTIMADO.
///
/// Es el tipo `SUP` del Excel, que NO era un tipo de item sino un nivel de
/// confianza del precio: los ocho insumos estimados sin factura de respaldo
/// (SPEC §5). Modelarlo como tipo de item habria sido copiar un error de la
/// hoja de calculo al esquema.
model PriceConfidence {
  code String @id

  items Item[]

  @@map("price_confidence")
}

/// Agrupacion de items para reportes. Por company: cada comercio agrupa como
/// quiere.
model ItemGroup {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  items   Item[]

  @@unique([companyId, name])
  @@map("item_group")
}

/// El ITEM es lo unico que ve quien arma una receta (SPEC §5).
///
/// Las lineas de receta apuntan a items sin distinguir tipo, lo que habilita la
/// recursion de las subpreparaciones. La validacion de ciclos llega en P4 y se
/// hace AL GUARDAR, no al calcular (R9).
model Item {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  name      String

  type            String
  unitOfUse       String  @map("unit_of_use")
  /// Rendimiento: fraccion aprovechable tras la limpieza. 1 = no se pierde
  /// nada. Dividir por el rendimiento ENCARECE el item (SPEC §12).
  yield           Decimal @db.Decimal(24, 12)
  groupId         String? @map("group_id") @db.Uuid
  status          String
  priceConfidence String  @map("price_confidence")

  /// Solo para PRODUCIDO: si la preparacion se produce en lote y aparece en
  /// inventario, o si al vender se explota su receta (SPEC §5). NULL para
  /// COMPRADO, y un CHECK lo hace cumplir.
  keepsStock Boolean? @map("keeps_stock")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company        Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  tipo           ItemType              @relation(fields: [type], references: [code])
  unidad         Unit                  @relation(fields: [unitOfUse], references: [code])
  grupo          ItemGroup?            @relation(fields: [groupId], references: [id], onDelete: Restrict)
  estado         ItemStatus            @relation(fields: [status], references: [code])
  confianza      PriceConfidence       @relation(fields: [priceConfidence], references: [code])
  articulos      PurchaseArticle[]
  precios        ReferencePrice[]
  recetas        Recipe[]
  lineasDeReceta RecipeLine[]
  empaqueDe      Product[]             @relation("empaque")
  movimientos    InventoryMovement[]
  producciones   InventoryProduction[]
  lineasDeConteo PhysicalCountLine[]

  @@unique([companyId, name])
  /// Clave candidata para las FK COMPUESTAS de receta y linea: atan el item a
  /// la misma company que la receta que lo usa.
  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([companyId, type])
  @@map("item")
}

/// El ARTICULO DE COMPRA es lo unico que ve quien registra una compra.
///
/// N articulos -> 1 item. Tres marcas distintas de harina son tres articulos y
/// un solo item, y en las recetas aparece solo el item (SPEC §5).
model PurchaseArticle {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  itemId    String @map("item_id") @db.Uuid

  name     String
  brand    String?
  supplier String?

  /// La presentacion, con su unidad: "2 kg", "900 ml", "6 unid".
  presentationAmount Decimal @map("presentation_amount") @db.Decimal(24, 12)
  presentationUnit   String  @map("presentation_unit")

  /// Cuantas unidades de USO salen de UN articulo. Es el divisor de
  /// `costo_bruto_uso = precio_neto / factor_conversion` (SPEC §12).
  ///
  /// Se DERIVA en el dominio cuando la presentacion y la unidad de uso
  /// comparten dimension, y se exige explicito cuando no. Se guarda calculado
  /// para que el costeo no dependa de leer el catalogo de unidades en cada
  /// consulta.
  conversionFactor Decimal @map("conversion_factor") @db.Decimal(24, 12)

  status    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  item        Item                @relation(fields: [itemId], references: [id], onDelete: Restrict)
  unidad      Unit                @relation(fields: [presentationUnit], references: [code])
  estado      ItemStatus          @relation(fields: [status], references: [code])
  precios     ReferencePrice[]
  movimientos InventoryMovement[]

  @@unique([companyId, name])
  /// Clave candidata para la FK COMPUESTA de `reference_price`: sostiene que el
  /// articulo al que apunta un precio pertenezca al item de ese mismo precio.
  @@unique([id, itemId])
  @@index([companyId, itemId])
  @@map("purchase_article")
}

// ---------------------------------------------------------------------------
// P3 — Precios de referencia con vigencia.
//
// R5: NINGUN PRECIO SE MUEVE SOLO. Todos se sugieren; el usuario confirma.
// Fila con vigencia, jamas campo sobrescrito (SPEC §6).
// ---------------------------------------------------------------------------

/// MANUAL · ULTIMA_COMPRA · EXTERNO (SPEC §6).
///
/// `EXTERNO` existe y no se usa: deja la puerta abierta a una fuente externa de
/// precios sin acoplar nada. D8 la deja fuera de alcance, y el catalogo es lo
/// unico que cuesta cero mantener mientras tanto.
model ReferencePriceOrigin {
  code String @id

  precios ReferencePrice[]

  @@map("reference_price_origin")
}

/// SUGGESTED · CONFIRMED · REJECTED.
///
/// El estado ES la regla R5: un precio sugerido no es vigente por mucho que su
/// `valid_from` haya pasado. Solo cuenta lo confirmado.
model ReferencePriceStatus {
  code String @id

  precios ReferencePrice[]

  @@map("reference_price_status")
}

/// Un precio con vigencia. NUNCA se actualiza el importe de una fila existente:
/// un precio nuevo es una fila nueva.
///
/// Lo unico que cambia en una fila es su ESTADO, y solo hacia adelante:
/// `SUGGESTED` -> `CONFIRMED` o `REJECTED`. Un trigger lo hace cumplir, porque
/// «solo el estado» no lo puede expresar un GRANT.
model ReferencePrice {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  itemId    String @map("item_id") @db.Uuid

  /// EL ARTICULO AL QUE PERTENECE ESTE PRECIO.
  ///
  /// Obligatorio para un item COMPRADO y prohibido para uno PRODUCIDO, con un
  /// trigger que lo hace cumplir. La razon es que un precio sin presentacion no
  /// significa nada: «2.30» solo es un dato junto a «el saco de 2 kg». De ahi
  /// sale ademas el factor de conversion que la formula de SPEC 12 necesita.
  ///
  /// Una preparacion PRODUCIDA no se compra: su precio es el **costo estandar**
  /// por unidad de uso que fija el usuario (SPEC 6, R10), y por eso no lleva
  /// articulo. Que el plato no cambie de costo segun cuanto se produjo ese dia
  /// es justamente el punto.
  purchaseArticleId String? @map("purchase_article_id") @db.Uuid

  /// El precio TAL COMO SE PAGA, con IVA incluido si lo lleva. La formula de
  /// SPEC §12 lo convierte a neto: `precio_neto = precio / (1 + iva_compra)`.
  price Decimal @db.Decimal(24, 12)

  /// LA TASA DE IVA QUE APLICO A ESTE PRECIO, no la de la company.
  ///
  /// El SPEC nombra `iva_compra` en la formula pero no dice donde vive, y §11
  /// solo trae «IVA de compra recuperable SI/NO». Vive aqui porque en Ecuador
  /// el alimento sin procesar es 0 % y el detergente 15 %: una unica tasa por
  /// company estaria equivocada para uno de los dos, y el error entra
  /// directamente en el costo de cada plato. La factura dice la tasa; esta
  /// columna la guarda. `company_settings.iva_compra` es solo el valor por
  /// defecto que se propone al capturar.
  ivaCompra Decimal @map("iva_compra") @db.Decimal(24, 12)

  origin    String
  status    String
  validFrom DateTime @map("valid_from") @db.Timestamptz(6)

  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Quien confirmo. NULL mientras siga sugerido: R5 en una columna.
  confirmedBy String?   @map("confirmed_by") @db.Uuid
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)

  /// Por que se sugirio. Para `ULTIMA_COMPRA`, cuanto se desvio la compra real.
  note String?

  company  Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  item     Item                 @relation(fields: [itemId], references: [id], onDelete: Restrict)
  fuente   ReferencePriceOrigin @relation(fields: [origin], references: [code])
  estado   ReferencePriceStatus @relation(fields: [status], references: [code])
  autor    AppUser              @relation("precios_creados", fields: [createdBy], references: [id], onDelete: Restrict)
  /// Relacion COMPUESTA: el articulo tiene que ser del mismo item. Sin esto, un
  /// precio podria apuntar al saco de harina y al item «cebolla».
  articulo PurchaseArticle?     @relation(fields: [purchaseArticleId, itemId], references: [id, itemId], onDelete: Restrict)

  /// El indice de CLAUDE.md §5: precio de referencia vigente de un item.
  /// Igualdad antes que rango, y el rango descendente porque «vigente» es
  /// «el mas reciente que ya empezo».
  @@index([companyId, itemId, validFrom(sort: Desc)])
  @@index([companyId, status])
  @@map("reference_price")
}

// ---------------------------------------------------------------------------
// P4 — Recetas, productos y combos (SPEC §8, §9, §13).
// ---------------------------------------------------------------------------

/// SIMPLE (receta a items) · COMBO (componentes que son productos simples).
model ProductType {
  code String @id

  productos Product[]

  @@map("product_type")
}

/// ACTIVE · INACTIVE. Sin borrado fisico.
model ProductStatus {
  code String @id

  productos Product[]

  @@map("product_status")
}

/// AP (tal como se compra) · EP (ya limpio).
///
/// ES EL CATALOGO MAS PEQUENO Y EL MAS PELIGROSO DEL SISTEMA. SPEC §13:
/// `costo_linea = cantidad × (base = "EP" ? costo_neto_uso : costo_bruto_uso)`.
/// Implementarlo al reves produce numeros plausibles y equivocados en las 293
/// lineas del Excel. R4.
model RecipeLineBase {
  code String @id

  lineas RecipeLine[]

  @@map("recipe_line_base")
}

/// ACTIVA · INACTIVA. Una linea inactiva cuesta CERO, no se borra: SPEC §13 la
/// tiene en la formula, y conservarla deja ver que se quito y cuando.
model RecipeLineStatus {
  code String @id

  lineas RecipeLine[]

  @@map("recipe_line_status")
}

/// ACTIVE · VOID.
///
/// `VOID` es una version que declara «aqui no hay receta», y hace falta para
/// revertir una propagacion sobre una ubicacion que NO tenia receta antes. Sin
/// ella habria que borrar la version creada —reescribiendo la historia— o
/// dejar una receta vacia, que cuesta cero y es una respuesta peligrosamente
/// distinta de «no hay receta».
model RecipeStatus {
  code String @id

  recetas Recipe[]

  @@map("recipe_status")
}

/// El producto de venta. Maestro de la COMPANY (SPEC §8).
///
/// LA UNIDAD DE COSTEO ES LA PORCION, NO EL PLATO: «Arroz con carne (segundo)»
/// y «(plato fuerte)» son productos DISTINTOS, con distinta receta, PVP y
/// margen. Sin jerarquia padre-hijo, porque el padre no tendria atributos
/// propios; para agrupar hay una etiqueta.
model Product {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  type      String
  /// Etiqueta simple de agrupacion para reportes. No es una jerarquia.
  category  String?
  status    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// EL EMPAQUE ES UN ITEM, no una tabla propia (P5, ADR-008).
  ///
  /// `T4_EMPAQUES` del Excel es una tabla aparte con su precio y su IVA. Aqui
  /// no: un empaque se compra, tiene articulo, tiene precio con vigencia y un
  /// dia se cuenta en el inventario. Darle tabla propia habria duplicado la
  /// cadena de costo entera —un segundo sitio donde viven precios— y R13 («el
  /// IVA recuperable afecta a items y empaques por igual») habria que
  /// implementarla dos veces.
  ///
  /// Con esto, `empaque_neto` de SPEC §14 es exactamente el `costo_neto_uso`
  /// del item: la misma formula, sin una linea nueva.
  packagingItemId String? @map("packaging_item_id") @db.Uuid

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  tipo          ProductType         @relation(fields: [type], references: [code])
  estado        ProductStatus       @relation(fields: [status], references: [code])
  empaque       Item?               @relation("empaque", fields: [packagingItemId, companyId], references: [id, companyId], onDelete: Restrict)
  ubicaciones   ProductLocation[]
  recetas       Recipe[]
  componentes   ComboComponent[]    @relation("combo")
  usadoEn       ComboComponent[]    @relation("componente")
  propagaciones RecipePropagation[]
  ventas        ProductSales[]

  @@unique([companyId, name])
  /// Clave candidata para las FK COMPUESTAS que atan todo a la misma company.
  @@unique([id, companyId])
  @@index([companyId, status])
  @@map("product")
}

/// Activacion, PVP y rendimiento por lote, POR LOCAL (SPEC §8).
///
/// El maestro arriba permite comparar entre locales con un `GROUP BY
/// product_id` en vez de emparejar por nombre, que es como se pierde la mitad
/// de los datos en cuanto alguien escribe una tilde distinta.
model ProductLocation {
  companyId  String @map("company_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid

  activo               Boolean  @default(true)
  /// PVP CON IVA incluido (R14). `venta_neta = pvp / (1 + iva_venta)`.
  pvp                  Decimal? @db.Decimal(24, 12)
  /// Cuantas porciones salen de un lote. Divide el costo de la receta.
  rendimientoPorciones Decimal? @map("rendimiento_porciones") @db.Decimal(24, 12)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  producto Product  @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Restrict)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([productId, locationId])
  @@index([companyId, locationId])
  @@map("product_location")
}

/// Componentes de un COMBO: productos SIMPLES, nunca items (SPEC §8).
///
/// «El combo usa las porciones reducidas, no los productos de carta», y en
/// menu engineering compite como item propio: el descuento NO se prorratea.
model ComboComponent {
  companyId          String  @map("company_id") @db.Uuid
  comboProductId     String  @map("combo_product_id") @db.Uuid
  componentProductId String  @map("component_product_id") @db.Uuid
  cantidad           Decimal @db.Decimal(24, 12)

  company    Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  combo      Product @relation("combo", fields: [comboProductId, companyId], references: [id, companyId], onDelete: Restrict)
  componente Product @relation("componente", fields: [componentProductId, companyId], references: [id, companyId], onDelete: Restrict)

  @@id([comboProductId, componentProductId])
  @@index([companyId, comboProductId])
  @@map("combo_component")
}

/// Una VERSION de receta, por par (destino, ubicacion) y con vigencia.
///
/// EL DESTINO ES UN PRODUCTO O UN ITEM, exactamente uno. Un producto de venta
/// tiene receta; una subpreparacion —item PRODUCIDO— tambien la tiene, y es lo
/// que habilita la recursion que R9 tiene que cortar. Las lineas apuntan a
/// items sin distinguir tipo (SPEC §5).
///
/// LAS RECETAS SE VERSIONAN POR VIGENCIA y no se editan: la propagacion crea
/// version nueva con fecha de hoy, y los costeos historicos no se recalculan
/// (SPEC §9). Es la misma regla que los precios de P3.
model Recipe {
  id         String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId  String @map("company_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid

  productId String? @map("product_id") @db.Uuid
  itemId    String? @map("item_id") @db.Uuid

  status    String
  validFrom DateTime @map("valid_from") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// De donde vino esta version: captura manual, propagacion o reversion.
  note      String?

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  location Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  producto Product?     @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Restrict)
  item     Item?        @relation(fields: [itemId, companyId], references: [id, companyId], onDelete: Restrict)
  estado   RecipeStatus @relation(fields: [status], references: [code])
  lineas   RecipeLine[]

  creadasPor RecipePropagationTarget[] @relation("creada")
  anteriorDe RecipePropagationTarget[] @relation("anterior")

  /// El indice de CLAUDE.md §5: receta vigente de un producto en una ubicacion.
  @@index([companyId, productId, locationId, validFrom(sort: Desc)])
  /// P5: costear una carta entera pide TODAS las recetas vigentes de una
  /// ubicacion de una vez, y esa consulta no lleva `product_id`. Sin este
  /// indice es un Seq Scan sobre `recipe`, y el presupuesto de 400 ms de
  /// CLAUDE.md §5 no lo aguanta con volumen real.
  @@index([companyId, locationId, validFrom(sort: Desc)], map: "recipe_por_ubicacion_y_vigencia")
  @@index([companyId, itemId, locationId, validFrom(sort: Desc)])
  @@map("recipe")
}

/// Una linea de receta: cuanto de que item, en que base (SPEC §13).
model RecipeLine {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  recipeId  String @map("recipe_id") @db.Uuid
  itemId    String @map("item_id") @db.Uuid

  /// En la UNIDAD DE USO del item. La unidad no se repite aqui: repetirla
  /// permitiria que dijera otra cosa que la del item, y entonces habria dos
  /// verdades sobre la misma cantidad.
  cantidad Decimal @db.Decimal(24, 12)
  base     String
  estado   String
  orden    Int     @default(0)

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  receta   Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  item     Item             @relation(fields: [itemId, companyId], references: [id, companyId], onDelete: Restrict)
  laBase   RecipeLineBase   @relation(fields: [base], references: [code])
  elEstado RecipeLineStatus @relation(fields: [estado], references: [code])

  @@unique([recipeId, itemId])
  @@index([companyId, recipeId])
  @@map("recipe_line")
}

/// Registro de una propagacion — R11, SPEC §9.
///
/// «Registro de quien propago que, con reversion por local». Es append-only en
/// la practica: revertir no borra la propagacion, le pone fecha de reversion y
/// crea versiones nuevas en cada ubicacion.
model RecipePropagation {
  id             String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId      String @map("company_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid
  sourceRecipeId String @map("source_recipe_id") @db.Uuid

  propagatedBy String    @map("propagated_by") @db.Uuid
  propagatedAt DateTime  @default(now()) @map("propagated_at") @db.Timestamptz(6)
  revertedBy   String?   @map("reverted_by") @db.Uuid
  revertedAt   DateTime? @map("reverted_at") @db.Timestamptz(6)

  company  Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  producto Product                   @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Restrict)
  destinos RecipePropagationTarget[]

  @@index([companyId, productId, propagatedAt(sort: Desc)])
  @@map("recipe_propagation")
}

/// Que le paso a CADA ubicacion en una propagacion.
///
/// `previousRecipeId` es lo que hace la reversion posible sin reescribir nada:
/// guarda cual era la version vigente antes. `null` significa que esa ubicacion
/// no tenia receta, y revertir le deja una version `VOID` — que es distinto de
/// una receta vacia, porque una receta vacia cuesta cero.
model RecipePropagationTarget {
  propagationId    String  @map("propagation_id") @db.Uuid
  locationId       String  @map("location_id") @db.Uuid
  previousRecipeId String? @map("previous_recipe_id") @db.Uuid
  createdRecipeId  String  @map("created_recipe_id") @db.Uuid

  propagacion RecipePropagation @relation(fields: [propagationId], references: [id], onDelete: Cascade)
  location    Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  anterior    Recipe?           @relation("anterior", fields: [previousRecipeId], references: [id], onDelete: Restrict)
  creada      Recipe            @relation("creada", fields: [createdRecipeId], references: [id], onDelete: Restrict)

  @@id([propagationId, locationId])
  @@map("recipe_propagation_target")
}

// ---------------------------------------------------------------------------
// P6 — Inventario: el libro mayor append-only.
//
// R3: NO EXISTE UN CAMPO `stock`. El saldo de un item en una ubicacion es la
// suma de sus movimientos y nada mas. Un campo mutable seria un segundo numero
// capaz de discrepar del libro, y cuando discrepara nadie sabria cual de los
// dos es el bueno.
//
// R2: el saldo existe POR UBICACION. Ninguna consulta suma dos ubicaciones
// salvo las vistas consolidadas explicitas de P9.
// ---------------------------------------------------------------------------

/// Los siete tipos de movimiento del SPEC 7, con lo que cada uno hace al saldo.
///
/// `direction` NO ES DECORATIVA: `inventory_movement` la repite y una clave
/// foranea COMPUESTA `(type, direction)` impide que discrepen, de modo que el
/// CHECK que cruza direccion con signo puede vivir en la fila del movimiento
/// —donde un CHECK no puede consultar otra tabla—. Mismo mecanismo con el que
/// P3 ato el articulo de compra a su item.
///
/// `AMBAS` la tienen solo `AJUSTE`, que existe para mover el saldo en la
/// direccion que haga falta, y `PRODUCCION`, que da de alta la preparacion y
/// consume sus insumos en el mismo hecho.
model InventoryMovementType {
  code      String @id
  direction String

  movimientos InventoryMovement[]

  @@unique([code, direction])
  @@map("inventory_movement_type")
}

/// El libro mayor. APPEND-ONLY EN TRES CAPAS, igual que `audit_log`:
///   1. Privilegio: REVOKE UPDATE, DELETE, TRUNCATE para costeo_app
///   2. Trigger BEFORE UPDATE OR DELETE OR TRUNCATE ... FOR EACH STATEMENT,
///      que alcanza tambien al dueno de la tabla
///   3. `audit:forbidden`, que avisa en el editor antes de llegar a la base
model InventoryMovement {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  locationId String @map("location_id") @db.Uuid
  itemId     String @map("item_id") @db.Uuid

  type      String
  /// Copia de la direccion del tipo, atada por FK compuesta. Ver arriba.
  direction String

  /// CON SIGNO: positivo entra, negativo sale. El saldo es `SUM(quantity)`.
  quantity Decimal @db.Decimal(24, 12)

  /// El dinero que se movio, SIN signo — el sentido lo lleva `quantity`.
  ///
  /// SE GUARDA EL TOTAL Y NO EL COSTO UNITARIO, y es deliberado: al comprar, el
  /// hecho es la factura. Reconstruirla como `cantidad x costo_unitario` obliga
  /// a una division previa cuyo redondeo pierde centavos, y `compras_del_mes`
  /// (SPEC 16) dejaria de cuadrar con lo que el cliente pago.
  totalCost Decimal? @map("total_cost") @db.Decimal(24, 12)

  /// Para una COMPRA: en que presentacion se compro. Es lo que permite el
  /// desglose por marca del SPEC 7, que es vista informativa y no saldo.
  purchaseArticleId String? @map("purchase_article_id") @db.Uuid

  /// Las dos patas de una transferencia comparten esta fila.
  transferId   String? @map("transfer_id") @db.Uuid
  /// El alta y los consumos de un lote comparten esta.
  productionId String? @map("production_id") @db.Uuid

  /// El movimiento que este anula (R3). Un movimiento con esto relleno es una
  /// correccion, y es el UNICO caso en que el signo puede contradecir a la
  /// direccion del tipo — porque su cantidad no la escribe nadie, se deriva.
  reversesMovementId String? @unique @map("reverses_movement_id") @db.Uuid

  /// Cuando ocurrio en el negocio. Es la fecha que manda para todo informe.
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  /// Cuando entro al libro. Nunca coinciden del todo, y la diferencia importa
  /// en una auditoria: dice cuanto se tardo en registrar.
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  createdBy String  @map("created_by") @db.Uuid
  note      String?

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  location   Location              @relation(fields: [locationId, companyId], references: [id, companyId], onDelete: Restrict)
  item       Item                  @relation(fields: [itemId, companyId], references: [id, companyId], onDelete: Restrict)
  tipo       InventoryMovementType @relation(fields: [type, direction], references: [code, direction])
  articulo   PurchaseArticle?      @relation(fields: [purchaseArticleId, itemId], references: [id, itemId], onDelete: Restrict)
  transfer   InventoryTransfer?    @relation(fields: [transferId], references: [id], onDelete: Restrict)
  produccion InventoryProduction?  @relation(fields: [productionId], references: [id], onDelete: Restrict)
  corrige    InventoryMovement?    @relation("correccion", fields: [reversesMovementId], references: [id], onDelete: Restrict)
  correccion InventoryMovement?    @relation("correccion")
  autor      AppUser               @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  /// CLAUDE.md 5: "movimientos de una ubicacion en un rango de fechas".
  @@index([companyId, locationId, occurredAt])
  /// CLAUDE.md 5: "saldo actual de un item en una ubicacion".
  @@index([companyId, locationId, itemId, occurredAt])
  @@index([companyId, transferId])
  @@index([companyId, productionId])
  @@map("inventory_movement")
}

/// La cabecera de una transferencia entre ubicaciones.
///
/// Existe para que las dos patas se puedan encontrar entre si y para guardar lo
/// que no cabe repetido en las dos: quien la hizo y por que. El invariante —que
/// el par sume cero— lo sostiene el dominio y lo comprueba una prueba.
model InventoryTransfer {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  fromLocationId String   @map("from_location_id") @db.Uuid
  toLocationId   String   @map("to_location_id") @db.Uuid
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String   @map("created_by") @db.Uuid
  note           String?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  origen  Location @relation("origen", fields: [fromLocationId, companyId], references: [id, companyId], onDelete: Restrict)
  destino Location @relation("destino", fields: [toLocationId, companyId], references: [id, companyId], onDelete: Restrict)
  autor   AppUser  @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  movimientos InventoryMovement[]

  @@index([companyId, occurredAt(sort: Desc)])
  @@map("inventory_transfer")
}

/// Un lote producido — R10.
///
/// LOS DOS COSTOS VIVEN AQUI, Y ESA ES LA REGLA ENTERA. El movimiento de alta
/// se valora al ESTANDAR, para que un plato no cambie de costo segun cuanto se
/// produjo ese dia. El costo REAL del lote se guarda al lado, y su diferencia
/// es la varianza — la senal de que la receta o el precio estandar se quedaron
/// viejos, que se pierde entera si se valora al costo real.
model InventoryProduction {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  locationId String @map("location_id") @db.Uuid
  /// El item PRODUCIDO que se da de alta.
  itemId     String @map("item_id") @db.Uuid

  quantity Decimal @db.Decimal(24, 12)

  standardUnitCost Decimal @map("standard_unit_cost") @db.Decimal(24, 12)
  standardTotal    Decimal @map("standard_total") @db.Decimal(24, 12)
  realTotal        Decimal @map("real_total") @db.Decimal(24, 12)

  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String   @map("created_by") @db.Uuid
  note       String?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [locationId, companyId], references: [id, companyId], onDelete: Restrict)
  item     Item     @relation(fields: [itemId, companyId], references: [id, companyId], onDelete: Restrict)
  autor    AppUser  @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  movimientos InventoryMovement[]

  @@index([companyId, locationId, occurredAt(sort: Desc)])
  @@map("inventory_production")
}

// ============================================================================
// P7 - Periodos y conteo fisico
// ============================================================================

/// ABIERTO - CERRADO (D6)
model PeriodStatus {
  code String @id

  periodos Period[]

  @@map("period_status")
}

/// El mes contable de UNA UBICACION - SPEC 3, D6.
///
/// POR UBICACION Y NO POR COMPANY. El conteo fisico se hace por ubicacion (R2)
/// y el cierre ocurre al cargarlo, asi que un periodo de company obligaria a
/// que las diez ubicaciones de una cadena contaran el mismo dia para poder
/// cerrar el mes. El consolidado de P9 agrega sobre ubicaciones, que es lo que
/// SPEC 18 ya dice de todo lo demas.
///
/// LA AUSENCIA DE FILA ES EL ESTADO ABIERTO. Un mes del que nadie se ha
/// ocupado no tiene fila, y eso significa abierto: exigir que alguien abra el
/// mes antes de registrar nada dejaria el sistema parado el dia 1 de cada mes.
///
/// `starts_at` / `ends_at` SE GUARDAN RESUELTOS. `occurred_at` es un instante
/// absoluto y preguntar de que mes es exige una zona horaria; resolverla una
/// vez, al abrir el periodo, hace que cambiarla algun dia no mueva de mes
/// movimientos ya cerrados. El intervalo es semiabierto: [starts_at, ends_at).
model Period {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  locationId String @map("location_id") @db.Uuid
  year       Int
  month      Int

  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)

  status String

  closedAt   DateTime? @map("closed_at") @db.Timestamptz(6)
  closedBy   String?   @map("closed_by") @db.Uuid
  reopenedAt DateTime? @map("reopened_at") @db.Timestamptz(6)
  reopenedBy String?   @map("reopened_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [locationId, companyId], references: [id, companyId], onDelete: Restrict)
  estado       PeriodStatus @relation(fields: [status], references: [code])
  cerradoPor   AppUser?     @relation("cerro", fields: [closedBy], references: [id], onDelete: Restrict)
  reabiertoPor AppUser?     @relation("reabrio", fields: [reopenedBy], references: [id], onDelete: Restrict)

  conteos     PhysicalCount[]
  ventas      ProductSales[]
  costosFijos FixedCost[]

  @@unique([companyId, locationId, year, month])
  /// Clave candidata para la FK COMPUESTA del conteo: ata cada conteo a la
  /// misma company que su periodo.
  @@unique([id, companyId])
  /// La consulta caliente: la hace TODA escritura del libro, para saber si la
  /// fecha cae en un mes cerrado. No lleva indice parcial sobre los cerrados
  /// —seria lo natural— porque la tabla tiene doce filas por ubicacion y ano y
  /// el indice completo ya resuelve la consulta con una hoja; un indice que
  /// Prisma no sabe declarar tendria que vivir en el bloque MANUAL y podria
  /// aparecer como deriva en `migrate:verify`, a cambio de nada medible.
  @@index([companyId, locationId, startsAt])
  @@map("period")
}

/// BORRADOR - CONFIRMADO
model PhysicalCountStatus {
  code String @id

  conteos PhysicalCount[]

  @@map("physical_count_status")
}

/// El conteo fisico de un periodo - SPEC 3 y 16, D7.
///
/// NO AJUSTA EL LIBRO. Emitir un AJUSTE por la diferencia haria que
/// `diferencia = conteo - stock_teorico` (SPEC 18) diera cero siempre, que es
/// justo la senal que el conteo existe para producir. El libro dice lo que
/// deberia haber; el conteo dice lo que hay; su resta es el hallazgo.
///
/// LOS TRES VALORES SE CONGELAN AL CONFIRMAR, y es la misma razon por la que
/// `inventory_production` congela el costo estandar (P6, ADR-009): dependen de
/// precios con vigencia, y recalcularlos manana podria dar otro numero para un
/// mes ya informado.
model PhysicalCount {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  periodId  String @map("period_id") @db.Uuid

  status String

  /// El corte: `period.ends_at` congelado. Es la frontera hasta la que se
  /// suman los movimientos para obtener el stock teorico.
  cutoffAt DateTime @map("cutoff_at") @db.Timestamptz(6)

  /// Copia de `period_id` cuando el conteo esta CONFIRMADO, y NULL mientras
  /// sea borrador. Es como se expresa "un solo conteo confirmado por periodo"
  /// con un indice unico corriente: `inventario_final_fisico` de SPEC 16 es EL
  /// conteo del mes, y con dos el food cost real dependeria de cual eligiera
  /// cada consulta. Un CHECK ata la copia a su original.
  confirmedPeriodId String? @unique @map("confirmed_period_id") @db.Uuid

  /// Suma sobre TODOS los items: lo que el libro dice que hay.
  theoreticalValue Decimal? @map("theoretical_value") @db.Decimal(24, 12)
  /// La parte de `theoretical_value` que alguien fue a verificar. La cobertura
  /// de D7 es su cociente, y no se guarda: dividir dos valores exactos es
  /// determinista, y guardar el cociente seria un tercer sitio para el mismo
  /// numero.
  coveredValue     Decimal? @map("covered_value") @db.Decimal(24, 12)
  /// El inventario final de SPEC 16: lo contado donde se conto, lo teorico
  /// donde no. Un item sin contar NO vale cero - eso equivaldria a declararlo
  /// consumido entero (D7).
  physicalValue    Decimal? @map("physical_value") @db.Decimal(24, 12)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String    @map("created_by") @db.Uuid
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)
  confirmedBy String?   @map("confirmed_by") @db.Uuid
  note        String?

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  periodo     Period              @relation(fields: [periodId, companyId], references: [id, companyId], onDelete: Restrict)
  estado      PhysicalCountStatus @relation(fields: [status], references: [code])
  autor       AppUser             @relation("conteos_creados", fields: [createdBy], references: [id], onDelete: Restrict)
  confirmante AppUser?            @relation("conteos_confirmados", fields: [confirmedBy], references: [id], onDelete: Restrict)

  lineas PhysicalCountLine[]

  @@unique([id, companyId])
  @@index([companyId, periodId])
  @@map("physical_count")
}

/// Una linea del conteo.
///
/// `quantity` NULL SIGNIFICA "SIN VERIFICAR", y no es lo mismo que cero (D7).
/// Cero es un dato: alguien miro y no habia. NULL es que nadie miro.
///
/// Mientras el conteo es BORRADOR solo existen lineas de lo que se conto. Al
/// CONFIRMAR se materializa una linea por cada item con saldo, con `quantity`
/// NULL en los que nadie conto, y se congelan `theoretical_quantity` y
/// `unit_cost`. A partir de ahi la conciliacion entera es una lectura de esta
/// tabla, y sigue dando el mismo numero dentro de un ano.
model PhysicalCountLine {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  countId   String @map("count_id") @db.Uuid
  itemId    String @map("item_id") @db.Uuid

  quantity Decimal? @db.Decimal(24, 12)

  /// Congelados al confirmar. NULL mientras el conteo sea borrador.
  theoreticalQuantity Decimal? @map("theoretical_quantity") @db.Decimal(24, 12)
  unitCost            Decimal? @map("unit_cost") @db.Decimal(24, 12)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  conteo  PhysicalCount @relation(fields: [countId, companyId], references: [id, companyId], onDelete: Restrict)
  item    Item          @relation(fields: [itemId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([countId, itemId])
  @@index([companyId, countId])
  @@map("physical_count_line")
}

// ============================================================================
// P8 - Vistas analiticas
// ============================================================================

/// Las unidades vendidas de un producto en un periodo - SPEC 10.
///
/// ES EL DATO DEL QUE DEPENDEN TRES DE LAS SEIS VISTAS: menu engineering,
/// punto de equilibrio y consumo teorico. El SPEC lo marca como riesgo de
/// producto: "digitar 48 productos por local cada mes es donde el sistema se
/// abandona", y por eso la API recibe un LOTE y no un producto (D9) — la
/// pantalla que lo hace tolerable es una grilla, y llega en P12.
///
/// VA CONTRA EL PERIODO Y NO CONTRA UNA FECHA. Una venta no es un instante en
/// esta tabla: es la cifra del mes. El instante lo tiene el libro, que registra
/// la CONSECUENCIA de vender sobre el stock; esto es la cifra de ventas, y son
/// datos distintos con periodos distintos.
model ProductSales {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  periodId  String @map("period_id") @db.Uuid
  productId String @map("product_id") @db.Uuid

  /// UNIDADES VENDIDAS: un entero no negativo, y la base lo hace cumplir con
  /// `units = trunc(units)`. La columna es `numeric` y no `integer` por
  /// coherencia con el resto del esquema —toda cantidad de este sistema vive en
  /// `numeric(24,12)`— y para que el dia que se vendan medias porciones el
  /// cambio sea soltar un CHECK y no migrar el tipo.
  ///
  /// El dominio lo modela como `Count`, que es lo que P5 ya asumia en
  /// `totalesDelMes` y lo que menu engineering necesita para contar.
  units Decimal @db.Decimal(24, 12)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid

  company  Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  periodo  Period  @relation(fields: [periodId, companyId], references: [id, companyId], onDelete: Restrict)
  producto Product @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Restrict)
  autor    AppUser @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([periodId, productId])
  @@index([companyId, periodId])
  @@map("product_sales")
}

/// MANO_DE_OBRA - OTRO_FIJO - VARIABLE
///
/// EL SPEC PIDE ESTA TABLA POR SU NOMBRE. SPEC 17 dice que en el Excel la mano
/// de obra se identifica con `Sueldos*` sobre el texto del conceptoy anade:
/// "el filtro por prefijo es fragil; en el SaaS, T6 necesita un campo explicito
/// de clasificacion". Un concepto llamado "Nomina" o "Salarios" quedaria fuera
/// del prime cost sin que nada avisara.
model FixedCostClassification {
  code         String  @id
  /// Si el importe es un MONTO mensual o una FRACCION de la venta neta.
  esPorcentaje Boolean @map("is_percentage")

  costos FixedCost[]

  @@map("fixed_cost_classification")
}

/// Una linea de T6: un concepto de costo del mes - SPEC 17.
///
/// EL IMPORTE SIGNIFICA DOS COSAS SEGUN LA CLASIFICACION, y lo dice el propio
/// catalogo con `is_percentage`:
///
///   MANO_DE_OBRA - OTRO_FIJO   monto mensual en dolares
///   VARIABLE                   fraccion de la venta neta (0.03 = 3 %)
///
/// Es lo que SPEC 17 escribe: `costos_fijos = SUMA(montos fijos)` y
/// `costos_variables_adic = venta_neta x pct_variable_total`. Modelarlo como
/// dos columnas dejaria una siempre nula y la otra siempre llena; modelarlo
/// como dos tablas duplicaria el CRUD entero.
model FixedCost {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  periodId  String @map("period_id") @db.Uuid

  concept        String
  classification String

  amount Decimal @db.Decimal(24, 12)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid

  company       Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  periodo       Period                  @relation(fields: [periodId, companyId], references: [id, companyId], onDelete: Restrict)
  clasificacion FixedCostClassification @relation(fields: [classification], references: [code])
  autor         AppUser                 @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([periodId, concept])
  @@index([companyId, periodId])
  @@map("fixed_cost")
}
