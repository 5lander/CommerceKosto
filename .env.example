# Plantilla de entorno de costeo-saas.
#
# Copiala a `.env` y rellena los valores. `.env` esta en .gitignore y la regla
# `sin-env-versionado` de audit:forbidden falla si alguien lo versiona.
#
# El esquema de entorno (Zod) valida esto AL ARRANCAR. La aplicacion no levanta
# si falta una variable o tiene formato invalido: es preferible no arrancar a
# arrancar mal configurada (docs/sistema/configuracion.md).
#
# CON TODOS LOS SELECTORES EN `fake`, EL SISTEMA FUNCIONA DE PUNTA A PUNTA SIN
# UNA SOLA CREDENCIAL REAL. Es un criterio de aceptacion de P0, no una comodidad.

# --- Base de datos -----------------------------------------------------------

POSTGRES_DB=costeo
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres

# Contrasenas locales. En produccion vienen del gestor de secretos, nunca de un
# archivo (SEGURIDAD.md §9). Genera valores largos y distintos entre si.
POSTGRES_SUPERUSER_PASSWORD=cambiame-superusuario
COSTEO_MIGRATOR_PASSWORD=cambiame-migrator
COSTEO_APP_PASSWORD=cambiame-app

# Rol de la APLICACION: costeo_app. No superusuario, no dueno de las tablas,
# sujeto a RLS. El esquema de entorno RECHAZA el arranque si el usuario de esta
# cadena no es exactamente `costeo_app`.
#
# Esas tres lineas de validacion cierran el fallo mas probable de todos: copiar
# aqui la cadena del migrator "para que funcione la migracion" y dejar toda la
# Barrera 1 en decorativa, sin que nada avise.
DATABASE_URL=postgresql://costeo_app:cambiame-app@localhost:5432/costeo?schema=public&connection_limit=10&pool_timeout=10

# Rol de MIGRACIONES: costeo_migrator, dueno de las tablas.
# NO debe existir en el entorno del proceso de la aplicacion en produccion.
MIGRATION_DATABASE_URL=postgresql://costeo_migrator:cambiame-migrator@localhost:5432/costeo?schema=public

# Base sombra que Prisma necesita para `migrate dev` y para generar los
# `down.sql` con `migrate diff`. La crea el script de inicializacion porque
# costeo_migrator es NOCREATEDB. Ver docs/incidencias/INC-004.
SHADOW_DATABASE_URL=postgresql://costeo_migrator:cambiame-migrator@localhost:5432/costeo_shadow?schema=public

# --- Aplicacion --------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# PUERTO INTERNO del proceso: el que la aplicacion escucha, dentro o fuera del
# contenedor. Lo valida el esquema de entorno.
PORT=3000

# PUERTO PUBLICADO EN EL HOST por `docker compose`. Es OTRA cosa que PORT, y
# por eso son dos variables: si algo del host ya ocupa el 3000 se cambia esta,
# sin tocar la configuracion de la aplicacion. La aplicacion NO la lee.
API_PORT=3000

# Timeout de peticion. Es la SEGUNDA defensa: la primera es `statement_timeout`,
# fijado en el propio rol `costeo_app`. Esta corta la peticion; aquella corta la
# consulta dentro de PostgreSQL. Ver http/timeout.interceptor.ts.
REQUEST_TIMEOUT_MS=15000

# Limitador de peticiones (SEGURIDAD.md §2.1). En P0 el contador vive en memoria
# del proceso; pasa a Redis en P1, cuando el limite deba ser el mismo para todas
# las replicas.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Origenes que pueden llamar a esta API desde un NAVEGADOR, separados por comas.
# SEGURIDAD.md 4.4: lista blanca exacta, jamas `*`, y sin barra final — el
# navegador manda `Origin: http://localhost:3001`, sin ella.
#
# VACIO SIGNIFICA NINGUNO, que es lo que valia antes de que existiera apps/web.
CORS_ORIGENES=http://localhost:3001

# --- Selectores de adaptador (CLAUDE.md §12) ---------------------------------
#
# `fake` usa la implementacion de `infrastructure/fakes/`, que cumple el mismo
# puerto, simula latencia y permite activar escenarios de error. Son parte del
# codigo mantenido y la base de las pruebas de integracion, no un descarte.

MAIL_ADAPTER=fake
STORAGE_ADAPTER=fake

# --- PgBouncer (modo transaccion) -------------------------------------------
# Lo levanta `npm run db:up` junto con la base. Las pruebas de integracion
# comprueban contra el la cuarta condicion de D12: que el tenant fijado con
# `set_config(..., TRUE)` NO sobreviva a la transaccion cuando el pooler
# reutiliza la conexion del servidor para otro cliente.
PGBOUNCER_DATABASE_URL=postgresql://costeo_app:cambiame-app@localhost:6432/costeo?schema=public&connection_limit=5&pool_timeout=10
