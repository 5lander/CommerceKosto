# Plantilla de entorno de costeo-saas.
#
# Copiala a `.env` y rellena los valores. `.env` esta en .gitignore y la regla
# `sin-env-versionado` de audit:forbidden falla si alguien lo versiona.
#
# El esquema de entorno (Zod) valida esto AL ARRANCAR. La aplicacion no levanta
# si falta una variable o tiene formato invalido: es preferible no arrancar a
# arrancar mal configurada (docs/sistema/configuracion.md).
#
# CON TODOS LOS SELECTORES EN `fake`, EL SISTEMA FUNCIONA DE PUNTA A PUNTA SIN
# UNA SOLA CREDENCIAL REAL. Es un criterio de aceptacion de P0, no una comodidad.

# --- Base de datos -----------------------------------------------------------

POSTGRES_DB=costeo
# Puerto del HOST donde se publica la base. Si otro proyecto de la maquina usa
# el 5432, cambialo aqui Y en las cinco cadenas `localhost:5432` de abajo, y
# recrea el contenedor (`docker compose up -d --no-deps db`). La guardia de
# pruebas y `audit:tests` leen el puerto de las cadenas, no de este valor
# (INC-007, caso 13); `npm run doctor` comprueba que contestan.
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres

# Contrasenas locales. En produccion vienen del gestor de secretos, nunca de un
# archivo (SEGURIDAD.md §9). Genera valores largos y distintos entre si.
POSTGRES_SUPERUSER_PASSWORD=cambiame-superusuario
COSTEO_MIGRATOR_PASSWORD=cambiame-migrator
COSTEO_APP_PASSWORD=cambiame-app

# El rol del back office (P11, ADR-017). ES EL UNICO QUE PUENTEA RLS: esta
# contrasena protege el acceso a TODOS los tenants a la vez, no a uno.
COSTEO_BACKOFFICE_PASSWORD=cambiame-backoffice

# El rol del despachador de correo (P16-A1, ADR-025). NO puentea RLS: solo ve
# `email_outbox` y `rate_limit_hit`, por politica permisiva y GRANT explicito.
# En un cluster que ya existia se crea con `npm run rol:despachador`.
COSTEO_DESPACHADOR_PASSWORD=cambiame-despachador

# Rol de la APLICACION: costeo_app. No superusuario, no dueno de las tablas,
# sujeto a RLS. El esquema de entorno RECHAZA el arranque si el usuario de esta
# cadena no es exactamente `costeo_app`.
#
# Esas tres lineas de validacion cierran el fallo mas probable de todos: copiar
# aqui la cadena del migrator "para que funcione la migracion" y dejar toda la
# Barrera 1 en decorativa, sin que nada avise.
DATABASE_URL=postgresql://costeo_app:cambiame-app@localhost:5432/costeo?schema=public&connection_limit=10&pool_timeout=10

# Rol de MIGRACIONES: costeo_migrator, dueno de las tablas.
# NO debe existir en el entorno del proceso de la aplicacion en produccion.
MIGRATION_DATABASE_URL=postgresql://costeo_migrator:cambiame-migrator@localhost:5432/costeo?schema=public

# Base sombra que Prisma necesita para `migrate dev` y para generar los
# `down.sql` con `migrate diff`. La crea el script de inicializacion porque
# costeo_migrator es NOCREATEDB. Ver docs/incidencias/INC-004.
SHADOW_DATABASE_URL=postgresql://costeo_migrator:cambiame-migrator@localhost:5432/costeo_shadow?schema=public

# --- Aplicacion --------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# PUERTO INTERNO del proceso: el que la aplicacion escucha, dentro o fuera del
# contenedor. Lo valida el esquema de entorno.
PORT=3000

# PUERTO PUBLICADO EN EL HOST por `docker compose`. Es OTRA cosa que PORT, y
# por eso son dos variables: si algo del host ya ocupa el 3000 se cambia esta,
# sin tocar la configuracion de la aplicacion. La aplicacion NO la lee.
API_PORT=3000

# Timeout de peticion. Es la SEGUNDA defensa: la primera es `statement_timeout`,
# fijado en el propio rol `costeo_app`. Esta corta la peticion; aquella corta la
# consulta dentro de PostgreSQL. Ver http/timeout.interceptor.ts.
REQUEST_TIMEOUT_MS=15000

# Limitador de peticiones (SEGURIDAD.md §2.1). En P0 el contador vive en memoria
# del proceso; pasa a Redis en P1, cuando el limite deba ser el mismo para todas
# las replicas.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Origenes que pueden llamar a esta API desde un NAVEGADOR, separados por comas.
# SEGURIDAD.md 4.4: lista blanca exacta, jamas `*`, y sin barra final — el
# navegador manda `Origin: http://localhost:3001`, sin ella.
#
# VACIO SIGNIFICA NINGUNO, que es lo que valia antes de que existiera apps/web.
CORS_ORIGENES=http://localhost:3001

# Desde que direcciones se cree la cabecera `X-Forwarded-For` (D-16.49): IPv4,
# redes IPv4 en CIDR o IPv6 exactas, separadas por comas. La API toma la IP del
# cliente del ULTIMO salto de esa cabecera SOLO cuando el socket viene de una
# de estas; si no, la IP es la del socket. Es la clave del bloqueo por IP del
# login, del limite de tasa de olvido/restablecimiento/invitaciones y del
# limitador global: detras de Caddy, sin esto, toda peticion cuenta como la IP
# de Caddy y un bloqueo por IP seria un bloqueo de TODOS (INC-022).
#
# VACIA SIGNIFICA NINGUNA: en desarrollo no hay proxy y el socket es la verdad.
# En produccion es la IP FIJA de Caddy en la red de compose (172.28.0.10, ver
# docker-compose.prod.yml), no la subred entera: en ella estan la pasarela y
# los demas contenedores. Nunca "todo" ni "las privadas": quien pueda poner
# la cabecera elegiria su IP. Una entrada que no es una direccion NO arranca.
# La leen la API y el back office.
PROXY_DE_CONFIANZA=

# --- Selectores de adaptador (CLAUDE.md §12) ---------------------------------
#
# `fake` usa la implementacion de `infrastructure/fakes/`, que cumple el mismo
# puerto, simula latencia y permite activar escenarios de error. Son parte del
# codigo mantenido y la base de las pruebas de integracion, no un descarte.

# `MAIL_ADAPTER`: `fake` (memoria) · `consola` (salida estandar) · `resend`.
# Lo usa el DESPACHADOR (`npm run correo:despachar`, servicio `correo`), no la
# API: la API NO ENVIA NINGUN correo, solo encola en `email_outbox` —la
# invitacion y el token de restablecimiento dentro de su misma transaccion, y
# el aviso de bloqueo del login— (ADR-025); para ella el valor da igual.
#
# EN DESARROLLO, `consola`: el despachador escribe cada correo —con su enlace—
# en la terminal, que es como se prueba una invitacion sin buzon. `fake` los
# marca ENVIADO sin ensenar nada (y en produccion no arranca); las pruebas de
# integracion montan el despachador con `fake` por su cuenta.
MAIL_ADAPTER=consola
STORAGE_ADAPTER=fake

# --- Correo transaccional (P16-A1) -------------------------------------------
#
# La URL PUBLICA del frontend, SIN barra final. De aqui salen los enlaces de
# los correos: `APP_URL/activacion?token=...` y `APP_URL/restablecer?token=...`.
# En desarrollo vale `http://localhost:3001` si se omite; en produccion es
# obligatoria, porque un enlace a localhost en el correo de un cliente es un
# fallo que nadie ve hasta que el cliente escribe.
APP_URL=http://localhost:3001

# Cuanto vive un enlace de restablecimiento de contrasena. Una hora es lo que
# tarda en leerse un correo y bastante menos de lo que tarda en robarse un
# buzon (D-16.34). La invitacion caduca a los siete dias y no se configura.
HORAS_DE_RESTABLECIMIENTO=1

# --- PgBouncer (modo transaccion) -------------------------------------------
# Lo levanta `npm run db:up` junto con la base. Las pruebas de integracion
# comprueban contra el la cuarta condicion de D12: que el tenant fijado con
# `set_config(..., TRUE)` NO sobreviva a la transaccion cuando el pooler
# reutiliza la conexion del servidor para otro cliente.
PGBOUNCER_DATABASE_URL=postgresql://costeo_app:cambiame-app@localhost:6432/costeo?schema=public&connection_limit=5&pool_timeout=10

# --- Back office (P11, ADR-017) ---------------------------------------
#
# PROCESO APARTE del de la app cliente: su propio pool, su propio puerto y
# su propio rol. `costeo_backoffice` es el UNICO rol que puentea RLS, asi
# que una consulta suya ve todos los tenants a la vez.
#
# APUNTA AL PUERTO DIRECTO, NUNCA A PGBOUNCER: son cuatro conexiones
# operadas a mano, no un pool que compartir, y mezclar la conexion
# privilegiada con el pooler de la aplicacion es exactamente el cruce que
# SPEC 1 prohibe.
#
# El proceso de la app cliente NO lee esta variable, y hay una prueba que
# lo comprueba: si la leyera, la separacion seria una convencion.
BACKOFFICE_DATABASE_URL=postgresql://costeo_backoffice:cambiame-backoffice@localhost:5432/costeo?schema=public&connection_limit=4&pool_timeout=10

# Se sirve en loopback. El back office NO se publica a internet: se llega
# por tunel SSH (docs/runbooks/despliegue.md).
BACKOFFICE_PORT=3101

# --- Despachador de correo (P16-A1, ADR-025) ---------------------------------
#
# Tercer proceso, con su propio rol y su propio pool de DOS conexiones. Apunta
# al puerto directo, no a PgBouncer, por la misma razon que el back office.
# `costeo_despachador` NO puentea RLS: lo que ve lo ve por una politica
# permisiva sobre `email_outbox` y `rate_limit_hit`, y nada mas.
#
# La API no lee esta variable —su esquema ni la conoce— y el despachador no
# lee DATABASE_URL: su esquema la rechaza. La lee `apps/api/src/despachador.ts`
# (`npm run correo:despachar`), y hay reglas de `audit:forbidden` que impiden
# nombrarla fuera de `modules/correo/`.
DESPACHADOR_DATABASE_URL=postgresql://costeo_despachador:cambiame-despachador@localhost:5432/costeo?schema=public&connection_limit=2&pool_timeout=10

# Con `MAIL_ADAPTER=resend`, las dos son obligatorias y el despachador no
# arranca sin ellas. El remitente va con el dominio verificado en Resend
# (DKIM, SPF, DMARC; `docs/runbooks/puesta-en-marcha.md`).
RESEND_API_KEY=
RESEND_REMITENTE=

# Cada cuanto pasa por la cola y cuantos correos toma por pasada.
CORREO_INTERVALO_MS=5000
CORREO_LOTE=20

# Minutos de `PENDIENTE` a partir de los cuales `GET /correo/salud` del back
# office los cuenta como retrasados (D-16.27c).
CORREO_MINUTOS_DE_ALERTA=15
